{
  "name": "trama-proyectos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch db.json --host 127.0.0.1 --port 43181",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write src vite.config.ts eslint.config.js index.html mockup.html seguimiento.html",
    "format:check": "prettier --check src vite.config.ts eslint.config.js index.html mockup.html seguimiento.html",
    "mcp": "tsx mcp/http.ts",
    "check:mcp": "tsc --noEmit --skipLibCheck --strict --target es2022 --module esnext --moduleResolution bundler --types vite/client,node mcp/server.ts mcp/http.ts",
    "test:mcp": "tsx --test mcp/tests/*.test.ts",
    "mcp:inspector": "mcp-inspector http://127.0.0.1:43182/mcp",
    "assistant": "tsx assistant/server.ts",
    "check:assistant": "tsc --noEmit --skipLibCheck --strict --target es2022 --module esnext --moduleResolution bundler --types node assistant/server.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "json-server": "^1.0.0-beta.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/inspector": "^2.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
