{
  "name": "mcp-alumnos-manual",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor MCP mínimo de alumnos por HTTP con Express y sin SDK MCP.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "contactos": "node contactos/server.js",
    "probar:contactos": "node --test contactos/contactos.test.js",
    "probar:sdk": "node sdk/cliente.js",
    "fastmcp": "node fastmcp/server.js",
    "probar:manual": "node manual/server.js & sleep 1; node manual/cliente.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "fastmcp": "^4.26.1",
    "zod": "^4.6.7"
  }
}
