{
  "name": "tp4-minicrm-murillo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test --test-isolation=none",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "db:setup": "npm run build && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.44.5",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.16.5",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
