{
  "name": "tp4-minicrm",
  "version": "1.0.0",
  "private": true,
  "description": "MiniCRM desarrollado con Node.js, TypeScript, Express, Drizzle y SQLite",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
