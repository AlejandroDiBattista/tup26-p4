{
  "name": "minicrm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TP4 - MiniCRM con Node.js, TypeScript, Express, Drizzle, SQLite y React",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.15.30",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
