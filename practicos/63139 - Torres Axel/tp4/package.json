{
  "name": "tp4-minicrm-axel-torres",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "drizzle-orm": "0.45.4",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
