{
  "name": "minicrm",
  "version": "1.0.0",
  "description": "MiniCRM: API REST con Express, Drizzle y SQLite + interfaz React",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "setup": "npm run db:init && npm run db:push"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
