{
  "name": "minicrm",
  "version": "1.0.0",
  "private": true,
  "description": "MiniCRM - TP4 Programacion 4 (Node.js + TypeScript + Drizzle + SQLite + Express + React)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc && node dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsc && node dist/db/seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
