{
  "name": "minicrm-drizzle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/servidor.ts",
    "start": "node --import tsx src/servidor.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "cross-env NODE_ENV=production drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx src/semilla.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/express": "^5.0.6",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
