@baseUrl = http://localhost:3000/api

### Estado de la API
GET {{baseUrl}}

### Listar clientes
GET {{baseUrl}}/clientes

### Buscar clientes por nombre, email o descripción de actividad
GET {{baseUrl}}/clientes?q=reunión

### Crear un cliente
POST {{baseUrl}}/clientes
Content-Type: application/json

{
  "nombre": "Lucía",
  "apellido": "Martínez",
  "telefono": "381-555-0199",
  "email": "lucia.martinez@example.com"
}

### Obtener un cliente por id
GET {{baseUrl}}/clientes/1

### Actualizar un cliente
PUT {{baseUrl}}/clientes/1
Content-Type: application/json

{
  "nombre": "Lucía",
  "apellido": "Martínez",
  "telefono": "381-555-0188",
  "email": "lucia.martinez@example.com"
}

### Eliminar un cliente
DELETE {{baseUrl}}/clientes/1

### Listar actividades
GET {{baseUrl}}/actividades

### Listar actividades pendientes
GET {{baseUrl}}/actividades?estado=pendientes

### Listar actividades vencidas
GET {{baseUrl}}/actividades?estado=vencidas

### Listar actividades sin plazo
GET {{baseUrl}}/actividades?estado=sin-plazo

### Crear una actividad
POST {{baseUrl}}/actividades
Content-Type: application/json

{
  "clienteId": 1,
  "descripcion": "Enviar información del servicio",
  "completa": false,
  "fechaComprometida": "2026-10-20T15:00:00.000Z"
}

### Obtener una actividad por id
GET {{baseUrl}}/actividades/1

### Actualizar una actividad
PUT {{baseUrl}}/actividades/1
Content-Type: application/json

{
  "descripcion": "Enviar propuesta actualizada",
  "completa": true,
  "fechaRealizacion": "2026-10-12T15:00:00.000Z"
}

### Eliminar una actividad
DELETE {{baseUrl}}/actividades/1
