# Base de datos local (valor por defecto si no existe .env)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Para usar Turso, reemplazar por los datos de la base remota:
# TURSO_DATABASE_URL=libsql://<base>-<usuario>.turso.io
# TURSO_AUTH_TOKEN=<token generado con: turso db tokens create <base>>

# Puerto del servidor web
PORT=3000
