# Copiar este archivo como ".env" (cp .env.example .env) y completar.

# Base de datos.
# Desarrollo: archivo SQLite local.
DATABASE_URL="file:./local.db"
# Producción (Turso): DATABASE_URL="libsql://<base>-<usuario>.turso.io"
DATABASE_AUTH_TOKEN=""

# Secreto con el que se firma la cookie de sesión (mínimo 32 caracteres).
# En producción usar uno distinto y cargarlo solo en Vercel. NUNCA subirlo al repositorio.
SESSION_SECRET="cambiar-este-secreto-por-uno-largo-y-aleatorio-123456"
